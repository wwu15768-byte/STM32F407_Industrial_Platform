# Normalize text files and use LF by default
* text=auto eol=lf

# STM32 / C / CMake
*.c           text eol=lf
*.h           text eol=lf
*.s           text eol=lf
*.S           text eol=lf
*.ld          text eol=lf
*.cmake       text eol=lf
CMakeLists.txt text eol=lf
*.ioc         text eol=lf

# Documentation and configuration
*.md           text eol=lf
*.txt          text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

# Binary files
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.pdf          binary
*.elf          binary
*.bin          binary
